<Window x:Class="MicroscopeSliderWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicroscopeSliderWPF"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="500" MinWidth="500" SizeToContent="WidthAndHeight">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Content="^" Click="ButtonZoomDown_Click" Margin="0,0,0,10"/>
            <Label Grid.Row="1" Content="0 µm" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Slider Grid.Row="2" x:Name="MicroSlider" Value="{Binding Zoom, Mode=TwoWay}" Style="{DynamicResource MicroscopeSlider}" Minimum="0" Maximum="15" Orientation="Vertical" IsDirectionReversed="True" TickPlacement="Both" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True" Margin="0,0,0,10"/>
            <Label Grid.Row="3" Content="15 µm" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button Grid.Row="4" Content="v" Click="ButtonZoomUp_Click" Margin="0,0,0,10"/>
        </Grid>

        <Image Grid.Column="1" x:Name="microscopeImage" Width="400" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" Source="Ressources/MicroscopeCapture.png"/>
    </Grid>
</Window>
